{
  "name": "unread",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @unread/web dev",
    "build": "pnpm --filter @unread/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @unread/db generate",
    "db:migrate": "pnpm --filter @unread/db migrate"
  }
}
