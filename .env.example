# Postgres on Tiger Data (pgvector enabled). Use the service URL with sslmode=require.
DATABASE_URL=postgres://unread:unread@localhost:5432/unread

# Auth0 (Regular Web Application). Callback: {APP_BASE_URL}/auth/callback, logout: {APP_BASE_URL}
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Domain for the per-user forwarding address (alias@INBOUND_EMAIL_DOMAIN)
INBOUND_EMAIL_DOMAIN=in.getunread.site
