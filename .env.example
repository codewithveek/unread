# Copy to apps/web/.env.local (web) and export for the worker. See docs/deploy.md.
# Note: a DATABASE_URL already set in your shell wins over .env files.

# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://unread:unread@localhost:5432/unread   # Tiger Cloud URL with ?sslmode=require in production
APP_BASE_URL=http://localhost:3000

# ── Auth0 (ADR 0002) ─────────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=                      # openssl rand -hex 32

# ── Storage (ADR 0009): local files in dev, S3/R2 in production ──────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/tmp/unread-storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=                       # e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Inbound email (ADR 0004) ─────────────────────────────────────────
INBOUND_EMAIL_DOMAIN=in.getunread.site
INBOUND_WEBHOOK_SECRET=            # same value as the Email Worker secret
INBOUND_TRUST_UPSTREAM_AUTH=false

# ── Gemma (ADR 0005) ─────────────────────────────────────────────────
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-31b-it
GEMINI_API_STYLE=native            # or "openai" for the OpenAI-compatible endpoint
OPENROUTER_API_KEY=                # fallback
OPENROUTER_MODEL=google/gemma-4-31b-it

# ── Voices, embeddings, audio (ADR 0005, 0006) ───────────────────────
ELEVENLABS_API_KEY=                # Plus/trials + SFX; see `npx @elevenlabs/cli onboard check`
KOKORO_CONCURRENCY=2
MODEL_CACHE_DIR=/tmp/unread-models
FFMPEG_PATH=ffmpeg

# ── News (ADR 0009) ──────────────────────────────────────────────────
SERPAPI_API_KEY=

# ── Billing (ADR 0007) ───────────────────────────────────────────────
BACHS_API_URL=https://sandbox-api.bachs.io
BACHS_API_KEY=                     # sk_sandbox_…
BACHS_WEBHOOK_SECRET=              # whsec_… (from the endpoint, or `bachs listen`)
BACHS_PLUS_MONTHLY_PRODUCT_ID=
BACHS_PLUS_YEARLY_PRODUCT_ID=

# ── Mail, scheduling, admin ──────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=Unread <hello@getunread.site>
TEMPORAL_ADDRESS=                  # empty = the worker polls instead (cut line)
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=
TEMPORAL_TASK_QUEUE=unread-episodes
ADMIN_EMAILS=                      # comma-separated, verified emails only
